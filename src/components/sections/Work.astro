---
import { getCollection } from 'astro:content';
import SectionHead from '../SectionHead.astro';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);

const pad = (n: number) => String(n).padStart(2, '0');
const statusLabel: Record<string, string> = {
  placeholder: 'TBD',
  'in-progress': 'In progress',
  shipped: 'Shipped',
  archived: 'Archived',
};
---

<section class="work wrap" id="work" aria-labelledby="work-title" data-work>
  <SectionHead index="01" label="Work" id="work-title">
    <span slot="aside">{pad(projects.length)} entries</span>
  </SectionHead>

  <ol class="work__list">
    {projects.map((p, i) => {
      const index = pad(p.data.order);
      const Row = p.data.href ? 'a' : 'div';
      return (
        <li class="work__item" style={`--delay:${i * 70}ms`} data-reveal>
          <Row
            class="work__row"
            href={p.data.href}
            data-work-row
            data-index={index}
            data-title={p.data.title}
            data-cursor="view"
            data-cursor-label={p.data.href ? 'View' : 'Soon'}
          >
            <span class="work__idx meta">{index}</span>
            <span class="work__name h2">{p.data.title}</span>
            <span class="work__meta meta">
              <span class="work__cell">{p.data.type ?? '—'}</span>
              <span class="work__cell">{p.data.year ?? '—'}</span>
              <span class="work__cell">{statusLabel[p.data.status] ?? p.data.status}</span>
            </span>
          </Row>
        </li>
      );
    })}
  </ol>

  <!--
    Preview plate. Trails the pointer over a hovered row (scripts/work.ts).
    Typographic for now; when projects have artwork, render it inside .work__plate-media.
  -->
  <div class="work__plate" aria-hidden="true" data-work-plate>
    <div class="work__plate-media">
      <span class="work__plate-idx h1" data-work-plate-idx>
        01
      </span>
    </div>
    <span class="work__plate-title micro" data-work-plate-title>
      Project one
    </span>
  </div>
</section>

<style>
  .work {
    padding-top: var(--s-section);
  }

  .work__list {
    margin-top: var(--s-6);
  }

  .work__item {
    border-bottom: 1px solid var(--c-rule);
    transition:
      opacity var(--d-2) var(--ease-out),
      border-color var(--d-2) var(--ease-out);
  }

  .work__row {
    display: grid;
    grid-template-columns: 4.5rem 1fr auto;
    align-items: baseline;
    column-gap: var(--gutter);
    padding-block: var(--s-6);
  }

  .work__idx {
    transition: color var(--d-1) var(--ease-out);
  }

  .work__name {
    color: var(--c-fg);
    transition: translate var(--d-2) var(--ease-out);
  }

  .work__meta {
    display: flex;
    gap: var(--s-6);
    justify-self: end;
    text-align: right;
    white-space: nowrap;
    transition: color var(--d-1) var(--ease-out);
  }

  .work__cell {
    min-width: 5ch;
  }

  /* ---- hover / focus: the row wakes, its siblings step back -------------- */
  .work__row:hover .work__idx,
  .work__row:focus-visible .work__idx {
    color: var(--c-accent);
  }

  .work__row:hover .work__name,
  .work__row:focus-visible .work__name {
    translate: 12px 0;
  }

  .work__row:hover .work__meta,
  .work__row:focus-visible .work__meta {
    color: var(--c-fg);
  }

  .work__item:has(.work__row:hover),
  .work__item:has(.work__row:focus-visible) {
    border-color: var(--c-rule-2);
  }

  .work__list:has(.work__row:hover) .work__item:not(:has(.work__row:hover)),
  .work__list:has(.work__row:focus-visible) .work__item:not(:has(.work__row:focus-visible)) {
    opacity: 0.32;
  }

  /* ---- plate ------------------------------------------------------------- */
  .work__plate {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 5;
    display: none;
    width: 14rem;
    pointer-events: none;
    opacity: 0;
    transition: opacity var(--d-2) var(--ease-out);
    will-change: translate;
  }

  .work__plate[data-on] {
    opacity: 1;
  }

  .work__plate-media {
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 3;
    border: 1px solid var(--c-rule-2);
    background: var(--c-bg);
  }

  .work__plate-idx {
    color: var(--c-fg-3);
  }

  .work__plate-title {
    display: block;
    margin-top: var(--s-2);
    color: var(--c-fg-3);
  }

  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    html[data-js] .work__plate {
      display: block;
    }
  }

  /* ---- recomposition ----------------------------------------------------- */
  @media (max-width: 63.99em) {
    .work__row {
      grid-template-columns: 3rem 1fr;
      row-gap: var(--s-3);
      padding-block: var(--s-5);
    }

    .work__meta {
      grid-column: 2;
      justify-self: start;
      text-align: left;
    }

    .work__row:hover .work__name,
    .work__row:focus-visible .work__name {
      translate: 6px 0;
    }
  }
</style>

<script>
  import { initWork } from '../../scripts/work';
  const section = document.querySelector<HTMLElement>('[data-work]');
  if (section) initWork(section);
</script>
