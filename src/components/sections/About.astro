---
import SectionHead from '../SectionHead.astro';
import SplitText from '../SplitText.astro';
import { site } from '../../config/site';
---

<section class="about wrap" id="about" aria-labelledby="about-title">
  <SectionHead index="02" label="About" id="about-title" />

  <div class="about__body grid">
    <div class="about__manifesto h1" data-reveal>
      <p>We are BugMara.</p>
      <p>We build.</p>
      <SplitText as="p" class="about__break" lines={['WE BREAK.']} data-fracture />
      <p>We learn.</p>
      <p>We build again.</p>
    </div>

    <div class="about__text" data-reveal style="--delay:120ms">
      <p class="body">
        BugMara is a technology and engineering collective from {site.location.country}. We build
        software and systems, take them apart to understand them, and build them again. Most of what
        we make starts as an experiment in the lab.
      </p>

      <dl class="about__facts meta">
        <div class="about__fact">
          <dt>Base</dt>
          <dd>
            {site.location.city}, {site.location.country}
          </dd>
        </div>
        <div class="about__fact">
          <dt>Est.</dt>
          <dd>—</dd>
        </div>
        <div class="about__fact">
          <dt>Team</dt>
          <dd>—</dd>
        </div>
        <div class="about__fact">
          <dt>Status</dt>
          <dd>
            <i class="dot" aria-hidden="true"></i> Active
          </dd>
        </div>
      </dl>
    </div>
  </div>
</section>

<style>
  .about {
    padding-top: var(--s-section);
  }

  .about__body {
    margin-top: var(--s-block);
    row-gap: var(--s-8);
  }

  .about__manifesto {
    grid-column: 1 / 9;
    /* One statement per line at every width: slightly under --t-h1. */
    font-size: clamp(2.5rem, 6.2vw, 6.75rem);
    color: var(--c-fg);
  }

  .about__manifesto p {
    color: var(--c-fg-3);
    transition: color var(--d-2) var(--ease-out);
  }

  .about__manifesto p:first-child,
  .about__manifesto p:last-child {
    color: var(--c-fg);
  }

  .about__manifesto:hover p {
    color: var(--c-fg);
  }

  .about__text {
    grid-column: 9 / 13;
    align-self: end;
    display: grid;
    gap: var(--s-7);
  }

  .about__facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-4) var(--s-6);
    padding-top: var(--s-5);
    border-top: 1px solid var(--c-rule);
  }

  .about__fact {
    display: grid;
    gap: var(--s-1);
  }

  .about__fact dd {
    color: var(--c-fg-2);
  }

  /* ---- "WE BREAK." fractures while held --------------------------------- */
  .about__break :global(.ch) {
    display: inline-block;
    transition:
      translate var(--d-2) var(--ease-out),
      rotate var(--d-2) var(--ease-out);
  }

  .about__break:hover :global(.ch),
  .about__break:active :global(.ch) {
    translate: calc((var(--sx) - 0.5) * 0.06em) calc((var(--sy) - 0.5) * 0.08em);
    rotate: calc((var(--sx) - 0.5) * 4deg);
  }

  /* The full stop falls further than the letters. */
  .about__break:hover :global(.ch:last-child),
  .about__break:active :global(.ch:last-child) {
    translate: 0 0.1em;
    rotate: 0deg;
  }

  @media (prefers-reduced-motion: reduce) {
    .about__break :global(.ch) {
      transition: none;
    }
  }

  /* ---- recomposition ----------------------------------------------------- */
  @media (max-width: 63.99em) {
    .about__manifesto,
    .about__text {
      grid-column: 1 / -1;
    }
    .about__text {
      max-width: 36rem;
    }
  }
</style>
