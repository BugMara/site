---
import { site } from '../config/site';
---

<header class="nav" data-nav>
  <a class="nav__brand" href="#top" aria-label={`${site.name} — top of page`}>
    {site.name}
  </a>

  <nav class="nav__nav" aria-label="Primary">
    <button
      class="nav__toggle meta"
      type="button"
      aria-expanded="false"
      aria-controls="nav-list"
      data-nav-toggle
    >
      MENU
    </button>
    <ul class="nav__list" id="nav-list">
      {site.nav.map((item) => (
        <li>
          <a class="nav__link meta" href={item.href} data-nav-link>
            <span class="nav__idx">{item.index}</span>
            <span class="nav__sep" aria-hidden="true">
              /
            </span>
            <span class="nav__label">{item.label}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: var(--z-nav);
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--nav-h);
    padding-inline: var(--margin);
    background: var(--c-bg);
  }

  .nav__brand {
    font-family: var(--f-sans);
    font-weight: var(--w-display);
    font-size: 0.9375rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    line-height: 1;
  }

  .nav__list {
    display: flex;
    gap: var(--s-6);
  }

  .nav__link {
    display: inline-flex;
    gap: 0.6em;
    color: var(--c-fg-3);
    transition: color var(--d-1) var(--ease-out);
  }

  .nav__link:hover,
  .nav__link:focus-visible,
  .nav__link[aria-current] {
    color: var(--c-fg);
  }

  .nav__idx {
    transition: color var(--d-1) var(--ease-out);
  }

  .nav__link[aria-current] .nav__idx {
    color: var(--c-accent);
  }

  .nav__toggle {
    display: none;
    color: var(--c-fg);
    padding: var(--s-2) 0;
  }

  /* ---- mobile: wordmark + MENU, list drops in as a plain column -------- */
  @media (max-width: 47.99em) {
    .nav__toggle {
      display: inline-block;
    }

    .nav__list {
      position: fixed;
      inset: var(--nav-h) 0 auto 0;
      flex-direction: column;
      gap: 0;
      padding: var(--s-4) var(--margin) var(--s-7);
      background: var(--c-bg);
      border-bottom: 1px solid var(--c-rule);
      opacity: 0;
      visibility: hidden;
      transition:
        opacity var(--d-2) var(--ease-out),
        visibility 0s linear var(--d-2);
    }

    .nav[data-open] .nav__list {
      opacity: 1;
      visibility: visible;
      transition-delay: 0s;
    }

    .nav__list li + li {
      border-top: 1px solid var(--c-rule);
    }

    .nav__link {
      width: 100%;
      padding-block: var(--s-4);
      font-size: var(--t-small);
    }

    .nav__idx {
      min-width: 2.5em;
    }

    .nav__sep {
      display: none;
    }
  }
</style>

<script>
  import { initNav } from '../scripts/nav';
  const header = document.querySelector<HTMLElement>('[data-nav]');
  if (header) initNav(header);
</script>
