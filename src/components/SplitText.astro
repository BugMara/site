---
/**
 * Splits text into per-character spans so CSS/JS can address letters individually.
 * The accessible name is the plain text; the spans are hidden from assistive tech.
 *
 * Each `.ch` carries `--i` (index) and two stable pseudo-random seeds `--sx`, `--sy` in
 * [0, 1) for per-letter effects that must not look identical on every letter.
 */
interface Props {
  lines: string[];
  as?: 'h1' | 'h2' | 'h3' | 'p' | 'span' | 'div';
  class?: string;
  id?: string;
  [key: `data-${string}`]: string | boolean | undefined;
}

const { lines, as: Tag = 'p', class: className, id, ...rest } = Astro.props;
const text = lines.join(' ');

let i = 0;
const seed = (n: number, k: number) => {
  // Deterministic hash → [0, 1). Stable across builds, so SSR and client agree.
  const x = Math.sin(n * 12.9898 + k * 78.233) * 43758.5453;
  return (x - Math.floor(x)).toFixed(3);
};
---

<Tag class={className} id={id} aria-label={text} {...rest}>
  {lines.map((line) => (
    <span class="line" aria-hidden="true">
      {[...line].map((ch) =>
        ch === ' ' ? (
          <span class="sp"> </span>
        ) : (
          <span class="ch" style={`--i:${i};--sx:${seed(i, 1)};--sy:${seed(i++, 2)}`}>
            {ch}
          </span>
        ),
      )}
    </span>
  ))}
</Tag>

<style>
  .line {
    display: block;
    white-space: nowrap;
  }
  .ch {
    display: inline;
  }
</style>
