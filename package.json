{
  "name": "bugmara-site",
  "version": "0.1.0",
  "private": true,
  "description": "BugMara — technology / engineering / experimentation. Nepal.",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "preview": "npx serve out",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.{ts,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"*.{ts,json,md}\"",
    "dev:turbo": "next dev",
    "build:turbo": "next build"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  }
}
